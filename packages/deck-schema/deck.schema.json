{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-applications-of.example/schemas/deck-1.0.0.json",
  "title": "Design Studio Deck Document",
  "description": "Portable, versioned source-of-truth format for presentation content.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "metadata",
    "design",
    "slides"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "audience",
        "brief",
        "tone"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "audience": {
          "type": "string",
          "maxLength": 500
        },
        "brief": {
          "type": "string",
          "maxLength": 10000
        },
        "tone": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "aspectRatio",
        "theme"
      ],
      "properties": {
        "direction": {
          "enum": [
            "editorial",
            "modern",
            "data"
          ]
        },
        "aspectRatio": {
          "const": "16:9"
        },
        "theme": {
          "enum": [
            "editorial",
            "dark",
            "analytical"
          ]
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "layout",
          "title",
          "body",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "layout": {
            "enum": [
              "title-body",
              "section-divider",
              "metric-highlight",
              "chart"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "body": {
            "type": "string",
            "maxLength": 10000
          },
          "notes": {
            "type": "string",
            "maxLength": 10000
          },
          "imageData": {
            "type": "string",
            "maxLength": 700000,
            "pattern": "^data:image/(png|jpeg|webp);base64,"
          },
          "imageAlt": {
            "type": "string",
            "maxLength": 300
          },
          "imageSource": {
            "type": "string",
            "maxLength": 500
          },
          "metricValue": {
            "type": "string",
            "maxLength": 80
          },
          "metricLabel": {
            "type": "string",
            "maxLength": 120
          },
          "chartType": {
            "enum": [
              "bar",
              "line"
            ]
          },
          "chartLabels": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          "chartValues": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "layout": {
                  "const": "metric-highlight"
                }
              },
              "required": [
                "layout"
              ]
            },
            "then": {
              "required": [
                "metricValue",
                "metricLabel"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "layout": {
                  "const": "chart"
                }
              },
              "required": [
                "layout"
              ]
            },
            "then": {
              "required": [
                "chartType",
                "chartLabels",
                "chartValues"
              ]
            }
          }
        ]
      }
    }
  }
}
